# Node
node_modules/

# The app's compiled data and build output are rebuilt from data/ and are not committed.
app/public/data/
app/dist/

# Large saved copies of sources stay on the machine that fetched them. The .cache.json beside
# each one is committed and says how to fetch it again. See tools/evidence.py.
evidence/**/*.pdf
evidence/**/*.jpg
evidence/**/*.png
evidence/.cache/
evidence/**/.download-*

